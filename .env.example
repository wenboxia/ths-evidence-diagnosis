# 扶摇金融数据 API Key（https://fuyao.aicubes.cn/admin/ 签发），请求头 X-api-key
FUYAO_API_KEY=

# LLM：任意 OpenAI 兼容接口（DeepSeek / 通义 / Kimi 均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 可选：MOCK_DATA=1 时使用 fixtures 里的“构造数据”（页面会显著标注），仅用于本地开发与测试
MOCK_DATA=

# 可选：备用 LLM（主供应商失败时自动切换）
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
